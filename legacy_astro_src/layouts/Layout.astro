---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MatriculaModal from '../components/MatriculaModal.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#002B5C" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Tipografía: Outfit + Plus Jakarta Sans + Lora -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Componente SEO dedicado -->
    <SEO title={title} description={description} image={image} />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <MatriculaModal />
  </body>
</html>
